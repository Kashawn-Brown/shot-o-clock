# ─────────────────────────────────────────────────────────────────────────────
# Shot O'Clock — .gitignore
# Covers: Node, Expo, Supabase local, OS junk, IDE configs, env files, builds
# ─────────────────────────────────────────────────────────────────────────────

# ─── Node / npm / pnpm ───
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/

# Lockfiles: package-lock.json IS committed. Other package managers' lockfiles
# are not, since we standardize on npm. Uncomment if you switch.
# pnpm-lock.yaml
# yarn.lock

# ─── Environment ───
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow the template
!.env.example

# ─── Expo ───
.expo/
.expo-shared/
dist/
web-build/

# EAS Build / Submit
ios/build/
android/build/
android/app/build/
*.ipa
*.apk
*.aab

# Expo Router cache
.expo/types/

# Native build artifacts (if you ever expo prebuild)
ios/Pods/
ios/.xcode.env.local
android/.gradle/
android/local.properties
android/app/release/

# ─── React Native ───
*.jsbundle

# ─── TypeScript ───
*.tsbuildinfo
.tsbuildinfo

# ─── Supabase local dev ───
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/logs/

# Supabase generated types live alongside source — committed deliberately.
# Do NOT add db.generated.ts here.

# ─── OS junk ───
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Editors / IDEs ───
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.fleet/
.zed/

# ─── Coverage and test artifacts ───
coverage/
.nyc_output/
junit.xml
*.lcov

# ─── Logs ───
*.log
logs/

# ─── Misc generated ───
.cache/
.parcel-cache/
.turbo/
.next/
out/

# ─── Local-only docs / scratch ───
# If you keep personal scratch notes inside the repo, name them with
# this prefix to keep them out of commits:
scratch.*
notes.local.*

# Store marketing-image build brief — personal working doc (the framed store
# screenshots + feature graphic are built by hand from it). Not committed.
store/screenshot-frames-brief.md

# Project docs (specs, planning, learning, etc.) — kept local, not committed
# going forward. Files remain on disk; older commits still contain them.
docs/

# Plain-English build narrative — local-only working doc.
build-log.md

# Local-only project working docs — progress tracker, decision log, and any
# machine-local CLAUDE overrides. timeline.md is now committed (public).
plan.md
decisions.md
CLAUDE.local.md

# ─── Lockfiles for tools we don't use ───
# (kept commented in case we switch tooling later)
# Cargo.lock
# Gemfile.lock

# Shot O'Clock — Mobile app environment (Expo)
#
# Expo loads this file from the app directory (apps/mobile/), NOT the repo root.
# Copy it to `.env` in this same folder and fill in the values:
#
#   cp apps/mobile/.env.example apps/mobile/.env
#
# Get the values from the local Supabase stack: run `supabase start` from the
# repo root and copy the "API URL" and "anon key" it prints. After editing
# .env, restart `npx expo start` for changes to take effect.
#
# Only EXPO_PUBLIC_* vars are exposed to the app bundle (read via src/lib/env.ts).
# Never put server secrets (service role key, etc.) in this file.
# `.env` is gitignored — never commit it.

# Supabase API URL — from `supabase start` output (typically http://127.0.0.1:54321).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon (public) key — from `supabase start` output, under "anon key".
# Safe to ship in the app: it only grants what RLS policies allow.
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...replace-me
